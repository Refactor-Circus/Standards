{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "refactor-circus/standards",
    "description": "Shared architectural standards for Laravel packages, with the tooling that enforces them: an arch preset, a PHPStan include and a Pint config.",
    "type": "phpstan-extension",
    "keywords": [
        "laravel",
        "architecture",
        "standards",
        "ringside"
    ],
    "homepage": "https://github.com/Refactor-Circus/Standards",
    "license": "MIT",
    "authors": [
        {
            "name": "Jay Fletcher",
            "email": "5743488+jayjfletcher@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "laravel/pint": "^1.32.1",
        "pestphp/pest": "^5.3.1",
        "symfony/yaml": "^7.2|^8.0"
    },
    "conflict": {
        "pestphp/pest": "<4.0"
    },
    "autoload": {
        "psr-4": {
            "RefactorCircus\\Standards\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RefactorCircus\\Standards\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "test:unit": [
            "vendor/bin/pest"
        ],
        "test": [
            "@lint:check",
            "@test:unit"
        ]
    },
    "extra": {
        "phpstan": {
            "includes": [
                "phpstan/rules.neon"
            ]
        },
        "ring-master": {
            "priority": 10,
            "kind": "architectural",
            "root": "standards",
            "index": "index.yml",
            "seeds": "seeds",
            "pint": "pint.json",
            "pest-preset": {
                "class": "RefactorCircus\\Standards\\Pest\\ArchPreset",
                "name": "refactorCircus"
            },
            "paths": {
                "models": [
                    "src/**/Models/**",
                    "database/migrations/**"
                ],
                "http": [
                    "src/**/Http/**",
                    "routes/**",
                    "src/**/routes.php"
                ],
                "actions": [
                    "src/**/Actions/**",
                    "src/**/Events/**"
                ],
                "data": [
                    "src/**/Data/**"
                ],
                "testing": [
                    "tests/**"
                ],
                "errors": [
                    "src/**/Exceptions/**"
                ]
            },
            "renames": {
                "architecture/actions-events": "actions/actions-events",
                "architecture/request-persist": "http/request-persist"
            }
        }
    },
    "suggest": {
        "refactor-circus/ringside": "Renders these standards into Claude Code skills and keeps the index in sync (^0.1)."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
